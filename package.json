{
  "name": "cf-ai-engineering-brief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "build:client": "vite build",
    "build": "npm run build:client && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run evidence",
    "test": "vitest run",
    "evidence": "node scripts/check-evidence.mjs",
    "audit": "npm audit --audit-level=high",
    "test:gates": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "dev:fixture": "npm run build:client && wrangler dev --config wrangler.fixture.jsonc --port 8788",
    "verify": "npm run check && npm run test:gates && npm run build:client && npm test && npm run build && npm run test:browser && npm run audit",
    "lint:ci": "node scripts/check-workflows.mjs"
  },
  "dependencies": {
    "agents": "0.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261027.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "node": "26.12.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "node@24.19.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
